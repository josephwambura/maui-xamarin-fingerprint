<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<Title>Fingerprint / Face ID / Biometric Plugin for MAUI</Title>
		<AssemblyName>Plugin.Fingerprint</AssemblyName>
		<RootNamespace>Plugin.Fingerprint</RootNamespace>

		<!-- Aligned with the MAUI project's SupportedOSPlatformVersion values -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<!-- BiometricPrompt requires API 24 (Android 7.0); matches MAUI project -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<!-- Matches MAUI project: min + target both pinned to 17763 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-android|AnyCPU'">
	  <IsAotCompatible>True</IsAotCompatible>
	  <RunAOTCompilation>True</RunAOTCompilation>
	  <AndroidEnableProfiledAot>True</AndroidEnableProfiledAot>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-ios|AnyCPU'">
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-maccatalyst|AnyCPU'">
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-windows10.0.19041.0|AnyCPU'">
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-android|AnyCPU'">
	  <IsAotCompatible>True</IsAotCompatible>
	  <RunAOTCompilation>True</RunAOTCompilation>
	  <AndroidEnableProfiledAot>True</AndroidEnableProfiledAot>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-ios|AnyCPU'">
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-maccatalyst|AnyCPU'">
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-windows10.0.19041.0|AnyCPU'">
	  <IsAotCompatible>True</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<None Include="readme.txt" Pack="true" PackagePath="." />
	</ItemGroup>

	<!-- ── Platform-specific source files ──────────────────────────────────────
       The SDK already globs all *.cs by default. We only need to REMOVE the
       folders that do not belong on each platform — no explicit Include needed.
  -->

	<!-- MacCatalyst: remove iOS, Android, Windows, NotImplemented -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<Compile Remove="Platforms\iOS\**\*.cs" />
		<Compile Remove="Platforms\Android\**\*.cs" />
		<Compile Remove="Platforms\Windows\**\*.cs" />
		<Compile Remove="Platforms\NotImplemented\**\*.cs" />
	</ItemGroup>

	<!-- iOS: remove MacCatalyst, Android, Windows, NotImplemented -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<Compile Remove="Platforms\MacCatalyst\**\*.cs" />
		<Compile Remove="Platforms\Android\**\*.cs" />
		<Compile Remove="Platforms\Windows\**\*.cs" />
		<Compile Remove="Platforms\NotImplemented\**\*.cs" />
	</ItemGroup>

	<!-- Android: remove MacCatalyst, iOS, Windows, NotImplemented -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<Compile Remove="Platforms\MacCatalyst\**\*.cs" />
		<Compile Remove="Platforms\iOS\**\*.cs" />
		<Compile Remove="Platforms\Windows\**\*.cs" />
		<Compile Remove="Platforms\NotImplemented\**\*.cs" />
		<PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.32" />
	</ItemGroup>

	<!-- Windows: remove MacCatalyst, iOS, Android, NotImplemented -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Compile Remove="Platforms\MacCatalyst\**\*.cs" />
		<Compile Remove="Platforms\iOS\**\*.cs" />
		<Compile Remove="Platforms\Android\**\*.cs" />
		<Compile Remove="Platforms\NotImplemented\**\*.cs" />
	</ItemGroup>
</Project>